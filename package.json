    "fast-xml-parser": "5.11.0",
    "fast-xml-validator": "1.4.2",
    "fflate": "0.8.3",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "typescript": "6.0.3",
